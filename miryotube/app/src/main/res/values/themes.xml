<?xml version="1.0" encoding="utf-8"?>
<resources>
    <color name="miryotube_background">#FF070707</color>
    <!-- The miryo banners' night background (the same in miryo iptv). -->
    <color name="splash_background">#FF10121A</color>

    <style name="Theme.MiryoTube" parent="android:Theme.Material.NoActionBar">
        <item name="android:windowBackground">@color/miryotube_background</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:windowFullscreen">true</item>
        <item name="android:windowContentOverlay">@null</item>
    </style>

    <!-- Launch: the logo on the night background (AndroidX SplashScreen, also on Android 9 to 11),
         then Theme.MiryoTube once MainActivity lets it go. -->
    <style name="Theme.MiryoTube.Starting" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/splash_background</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/splash_logo</item>
        <item name="postSplashScreenTheme">@style/Theme.MiryoTube</item>
        <item name="android:windowFullscreen">true</item>
    </style>
</resources>
